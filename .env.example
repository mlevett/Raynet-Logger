RAYNET_ORG_NAME=South East Hampshire RAYNET
RAYNET_TIMEZONE=Europe/London
RAYNET_DATA_DIR=./data
RAYNET_BACKUP_DIR=./backups
RAYNET_SESSION_HOURS=12
RAYNET_BACKUP_INTERVAL_SECONDS=300
RAYNET_BACKUP_RETENTION=48
RAYNET_NODE_NAME=Field node 1
# Use the same long random secret on trusted nodes that should exchange records:
RAYNET_SYNC_SECRET=
RAYNET_SYNC_INTERVAL_SECONDS=30
# Set to 1 only when the app is served over HTTPS:
RAYNET_SECURE_COOKIE=0
